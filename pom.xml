<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- O "parent" do Spring Boot ja define as versoes compativeis de dezenas
         de bibliotecas. Por isso a maioria das dependencias abaixo nao precisa
         declarar <version>: quem decide e o parent. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.smartkey</groupId>
    <artifactId>smartkey-api</artifactId>
    <version>0.2.0</version>
    <name>SmartKey API</name>
    <description>Chave digital temporaria para hospedagens</description>

    <properties>
        <!-- Seu JDK e o 24, mas compilamos para Java 21 (versao LTS).
             Motivo: 21 e a versao mais estavel e suportada em qualquer
             servidor de nuvem. O programa roda igual no seu JDK 24. -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>2.8.6</springdoc.version>
    </properties>

    <dependencies>

        <!-- Servidor web + controllers REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Acesso ao banco de dados (JPA / Hibernate) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Security: autenticacao, autorizacao e cabecalhos de seguranca.
             Substitui os filtros caseiros, que comparavam o endereco "cru" da
             requisicao enquanto o Spring roteava pelo endereco normalizado -
             e um "/api;/admin" passava pelo meio dos dois. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Validacao automatica dos dados que chegam na API (@NotNull, etc) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Driver do PostgreSQL (fala com o Supabase) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- H2: banco que roda DENTRO da propria aplicacao, na memoria.
             Usado apenas pelo perfil "demo", para voce ver o sistema
             funcionando sem depender de nenhum banco externo.
             Os dados somem quando a aplicacao e encerrada. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway: versiona o banco de dados.
             Cada arquivo .sql em db/migration e aplicado uma unica vez,
             em ordem. Assim seu banco local e o da nuvem ficam identicos. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Swagger UI: uma pagina no navegador onde voce testa a API
             clicando em botoes, sem precisar decorar comandos curl.
             Fica em http://localhost:8080/swagger-ui.html -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ZXing: gera a imagem do QR Code.
             Usamos a versao "core", que produz apenas a matriz de pontos;
             o desenho em SVG e feito por nos, sem depender de bibliotecas
             graficas (que nao existem em servidores sem tela). -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>

        <!-- Testes: JUnit 5 + AssertJ + MockMvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- PostgreSQL de verdade dentro dos testes, SEM Docker: baixa o
             binario do Postgres como uma dependencia comum do Maven e o sobe
             num diretorio temporario. Permite rodar as migracoes do Flyway
             no mesmo banco que vai para producao. -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.1.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Gera o arquivo .jar executavel -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
